# Copia a backend/.env.tunel (ignorado por git). Lo lee `make tunel`.

# Origen del front, para CORS
FRONT_URL=https://bifurca.onrender.com

# Con el túnel rápido la URL cambia en cada arranque. Con estas dos, el script cambia VITE_API_URL del
# front en Render y lo redespliega solo. API key: Render > Account Settings > API Keys.
# Id del front: la parte srv-... de la URL del servicio en el dashboard.
# RENDER_API_KEY=rnd_...
# RENDER_FRONT_ID=srv-...

# Túnel con nombre (URL fija, pide un dominio en Cloudflare). Si están, no hace falta lo de Render.
# TUNEL_NOMBRE=bifurca
# TUNEL_URL=https://api.tudominio.cl
